{
  "name": "display-video-360-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Google Display & Video 360: campaign data and Bid Manager performance reports.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "start:http": "node dist/remote/main.js",
    "dev:http": "tsx watch src/remote/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnverOnal/display-video-360-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dv360",
    "display-video-360",
    "bid-manager",
    "google-ads"
  ],
  "author": "UnverOnal",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/UnverOnal/display-video-360-mcp-server/issues"
  },
  "homepage": "https://github.com/UnverOnal/display-video-360-mcp-server#readme",
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.5",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "google-auth-library": "^11.3.3",
    "jose": "^6.2.17",
    "read-excel-file": "^9.3.14",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
